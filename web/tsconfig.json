{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "@aggr-model/*": [
        "./.generated/types/*"
      ]
    }
  },
  "include": [
    "src",
    "test"
  ],
  "exclude": [
    "src/sw",
    "test/projector.ts"
  ]
}
