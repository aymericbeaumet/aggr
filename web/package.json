{
  "name": "aggr-reader",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test:dev": "node --test dev/*.test.mjs",
    "verify:release": "node dev/verify-release.mjs",
    "build": "node build.ts",
    "check": "svelte-check --tsgo --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "node build.ts && vitest run",
    "verify": "npm run check && npm test"
  },
  "dependencies": {
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/node": "^26.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "jsdom": "^30.1.2",
    "svelte-check": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
