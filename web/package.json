{
  "name": "aggr-reader",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "build": "vite build && vite build --config vite.bootstrap.config.ts && vite build --config vite.worker.config.ts",
    "check": "svelte-check --tsgo --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "verify": "npm run check && npm test && npm run build"
  },
  "dependencies": {
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/node": "^26.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "jsdom": "^30.1.2",
    "svelte-check": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
