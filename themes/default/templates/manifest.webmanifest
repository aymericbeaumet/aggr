{# Rendered to <site>/manifest.webmanifest; colours match style.css. #}
{
  "name": "aggr",
  "short_name": "aggr",
  "description": {{ site.description | json }},
  "lang": {{ site.language | json }},
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#f5f6fa",
  "theme_color": "#291a1b",
  "icons": [
    { "src": "{{ 'assets/icon-192.png' | url_for }}", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "{{ 'assets/icon-512.png' | url_for }}", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "{{ 'assets/icon-maskable-512.png' | url_for }}", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "{{ 'assets/apple-touch-icon.png' | url_for }}", "sizes": "180x180", "type": "image/png" }
  ],
  "shortcuts": [
    { "name": "Feed", "short_name": "Feed", "url": "./", "icons": [{ "src": "{{ 'assets/icon-192.png' | url_for }}", "sizes": "192x192" }] },
    { "name": "Search", "short_name": "Search", "url": "{{ 'search/' | url_for }}", "icons": [{ "src": "{{ 'assets/icon-192.png' | url_for }}", "sizes": "192x192" }] }
  ],
  "categories": ["news", "productivity"],
  "prefer_related_applications": false
}
